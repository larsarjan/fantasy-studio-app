            <script defer="">
                window.addEventListener("message", function (event) {
                    const allowedDomains = [
                        ".espngoal.nl",
                        ".ismgames.com",
                        ".eredivisie.app",
                    ];
                    const url = new URL(event.origin);
                    const hostname = url.hostname;
                    const isAllowedDomain = allowedDomains.some(
                        (domain) =>
                            hostname === domain || hostname.endsWith(domain)
                    );
                    if (!isAllowedDomain || !event.data || !event.data.type)
                        return;

                    switch (event.data.type) {
                        case "conviva_initializing":
                            console.info("Conviva is initializing in iframe");
                            break;
                        case "conviva_checking_consent":
                            console.info(
                                "Conviva is checking consent in iframe"
                            );
                            break;
                        case "conviva_consent_given":
                            console.info("Conviva consent given in iframe");
                            break;
                        case "conviva_consent_not_given":
                            console.info("Conviva consent not given in iframe");
                            break;
                        case "conviva_initialized":
                            console.info("Conviva initialized in iframe");
                            break;
                        case "conviva_custom_event_tracked":
                            console.info(
                                "Conviva custom event tracked in iframe:",
                                event.data.data
                            );
                            break;
                        case "conviva_page_view_tracked":
                            console.info("Conviva page view tracked in iframe");
                            break;
                        case "one_trust_not_loaded_yet":
                            console.info("OneTrust not loaded yet in iframe");
                            break;
                        case "one_trust_loaded":
                            console.info("OneTrust loaded in iframe");
                            break;
                        default:
                            console.info(
                                "Unknown message type from iframe:",
                                event.data.type
                            );
                    }
                });
            </script>
