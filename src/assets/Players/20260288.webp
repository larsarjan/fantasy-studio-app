            <script>
                const hasGivenConsent = (categoryId) => {
                    if (!categoryId) {
                        console.warn(
                            "[CONVIVA] hasGivenConsent: categoryId is not provided"
                        );
                        return false;
                    }

                    if (
                        !window.OnetrustActiveGroups &&
                        typeof window.OnetrustActiveGroups !== "string"
                    ) {
                        console.warn(
                            "[CONVIVA] hasGivenConsent: Cannot check consent"
                        );
                        return false;
                    }
                    console.info(
                        `[CONVIVA] Checking consent for category: ${categoryId}`
                    );
                    return window.OnetrustActiveGroups.includes(categoryId);
                };

                const analyticsCategoryId = "C0002";
            </script>
            <script defer="">
                let menuIsOpen = false;

                function initializeMenu() {
                    const toggleButton = document.querySelector(".toggle");

                    toggleButton.addEventListener("click", () => {
                        menuIsOpen = !menuIsOpen;
                        document
                            .querySelector(".navigation-mobile")
                            .classList.toggle("is-open", menuIsOpen);
                        toggleButton.setAttribute("aria-expanded", menuIsOpen);
                    });
                }

                function replaceNLTextWithENText() {
                    if (window.location.hostname.substring(0, 2) !== "en")
                        return;

                    const elements = document.querySelectorAll("[data-en]");
                    elements.forEach((element) => {
                        const dataValue = element.getAttribute("data-en");
                        if (dataValue) {
                            element.textContent = dataValue;
                        }
                    });

                    const altElements =
                        document.querySelectorAll("[data-en-alt]");
                    altElements.forEach((element) => {
                        const altValue = element.getAttribute("data-en-alt");
                        if (altValue) {
                            element.setAttribute("alt", altValue);
                        }
                    });
                }

                function initialize() {
                    replaceNLTextWithENText();
                    initializeMenu();
                }

                if (document.readyState === "loading") {
                    window.addEventListener("DOMContentLoaded", initialize);
                } else {
                    initialize();
                }
            </script>
